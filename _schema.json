      },
      "title": "Tools",
      "type": "array"
    },
    "context": {
      "items": {
        "$ref": "#/$defs/Context"
      },
      "title": "Context",
      "type": "array"
    },
    "forwardedProps": {
      "title": "Forwardedprops"
